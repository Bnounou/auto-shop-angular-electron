{
  "name": "auto-shop-angular-electron",
  "version": "2.2.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "electron": "npm run build && electron .",
    "dev:electron": "concurrently \"ng serve\" \"wait-on http://localhost:4200 && electron .\"",
    "dist": "npm run build && electron-builder",
    "rebuild:native": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@angular/animations": "20.3.32",
    "@angular/common": "20.3.32",
    "@angular/compiler": "20.3.32",
    "@angular/core": "20.3.32",
    "@angular/forms": "20.3.32",
    "@angular/platform-browser": "20.3.32",
    "@angular/router": "20.3.32",
    "better-sqlite3": "^13.0.3",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "chart.js": "^4.5.0",
    "jsbarcode": "^3.11.6",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.30",
    "@angular/cli": "^20.3.30",
    "@angular/compiler-cli": "20.3.32",
    "concurrently": "^9.2.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "~5.8.3",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "dz.autoshop.app",
    "productName": "AUTO SHOP",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "database.js",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/AUTOSHOP-LOGO.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
